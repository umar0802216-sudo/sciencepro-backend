
const express = require("express");

const app = express();
app.use(express.json());

const plans = {
  daily: { amount: 20000, days: 1 },
  weekly: { amount: 100000, days: 7 },
  monthly: { amount: 300000, days: 30 },
  special: { amount: 500000, days: 90 }
};

app.get("/", (req, res) => {
  res.send("SciencePro backend is running.");
});

app.post("/api/payment/initialize", async (req, res) => {
  try {
    const { email, planId } = req.body;
    const plan = plans[planId];

    if (
      typeof email !== "string" ||
      !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) ||
      !plan
    ) {
      return res.status(400).json({
        error: "Valid email and plan are required."
      });
    }

    const secret = process.env.PAYSTACK_SECRET_KEY;

    if (!secret) {
      return res.status(500).json({
        error: "Payment service is not configured."
      });
    }

    const response = await fetch(
      "https://api.paystack.co/transaction/initialize",
      {
        method: "POST",
        headers: {
          Authorization: `Bearer ${secret}`,
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          email,
          amount: plan.amount,
          currency: "NGN",
          metadata: {
            planId,
            accessDays: plan.days
          }
        })
      }
    );

    const result = await response.json();

    if (!response.ok || !result.status) {
      return res.status(502).json({
        error: "Could not initialize payment."
      });
    }

    return res.json({
      authorization_url: result.data.authorization_url,
      reference: result.data.reference
    });
  } catch {
    return res.status(500).json({
      error: "Unexpected server error."
    });
  }
});

const PORT = process.env.PORT || 10000;

app.listen(PORT, "0.0.0.0", () => {
  console.log(`SciencePro backend listening on ${PORT}`);
});
